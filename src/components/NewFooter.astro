---
import Default from '@astrojs/starlight/components/Footer.astro';
import Comments from './Comments.astro';

const isBlogHomepage = Astro.locals.starlightRoute.id === 'blog';
const path = Astro.locals.starlightRoute.id
---

{
    isBlogHomepage ? (
        <Default><slot /></Default> 
    ) : (
        <Default><slot /></Default>

        <Comments envId={'https://comment.syrinxhome.com'} path={path} />
    )
}
